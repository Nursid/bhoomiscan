# React Native app configuration
# Point this to your backend. The mobile app must not call Decentro directly.
TRUSTLEDGE_KYC_API_BASE_URL=https://third-party-pa56.onrender.com

# Backend-only Decentro configuration
# Keep these in the backend environment, not bundled in the React Native app.
DECENTRO_BASE_URL=https://in.staging.decentro.tech
DECENTRO_CLIENT_ID=your_decentro_client_id
DECENTRO_CLIENT_SECRET=your_decentro_client_secret
DECENTRO_DIGILOCKER_REDIRECT_URL=trustledge://digilocker/callback

# Optional. Add only if Decentro issued a module secret for your account.
DECENTRO_MODULE_SECRET=

# Backend-only Meon Land Record & DigiLocker API configuration.
# Keep these in the backend environment, not bundled in the React Native app.
MEON_BASE_URL=https://digilocker.meon.co.in/digi_url
MEON_CLIENT_ID=your_meon_client_id
MEON_COMPANY_NAME=your_company_name
MEON_SECRET_TOKEN=your_meon_secret_token
MEON_REDIRECT_URL=trustledge://digilocker/callback
MEON_API_KEY=your_meon_api_key
MEON_PUNJAB_SIGNATURE=your_punjab_signature
MEON_MAHARASHTRA_SIGNATURE=your_maharashtra_signature
MEON_UP_SIGNATURE=your_uttar_pradesh_signature
MEON_RAJASTHAN_SIGNATURE=your_rajasthan_signature
MEON_MP_SIGNATURE=your_madhya_pradesh_signature

# Backend-only SMTP notification configuration.
# Render Free blocks outbound SMTP ports 25, 465, and 587.
# Use an SMTP provider that supports port 2525, or upgrade Render to a paid instance.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_provider_smtp_password
SMTP_FROM="Destiny Protocol <your_sender@gmail.com>"

# Backend-only BNB Smart Chain (BSC) Configuration
# Required for Land Verification & Vault smart contract transactions.
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_CHAIN_ID=97
BSC_EXPLORER_TX_URL=https://testnet.bscscan.com/tx/
# Operator wallet private key funded with testnet/mainnet BNB for transaction gas
OPERATOR_PRIVATE_KEY=your_operator_private_key
BSC_RELAYER_PRIVATE_KEY=your_operator_private_key
# Deployed LandVerification Smart Contract Address
LAND_VERIFICATION_CONTRACT_ADDRESS=0xYourLandVerificationContractAddress
BSC_LAND_REGISTRY_ADDRESS=0xYourLegacyLandRegistryAddress

# Backend-only MSG91 OTP Widget credentials for POST /api/auth/mobile-verify.
# The UI runs the widget's sendOtp(); the backend verifies the OTP with MSG91's
# widget verifyOtp API. No OTP is generated, stored or compared on the backend.
# Never bundle these in the React Native app.
MSG91_WIDGET_ID=your_msg91_widget_id
MSG91_TOKEN_AUTH=your_msg91_widget_token_auth
# Optional fallback credential (account auth key) used only when MSG91_TOKEN_AUTH is empty.
# MSG91_AUTH_KEY=
# Optional: MSG91_BASE_URL=https://control.msg91.com  MSG91_TIMEOUT_MS=15000
# Development aid: log the (credential-redacted) verifyOtp response shape.
# MSG91_DEBUG_VERIFY_RESPONSE=false
# Country code applied to bare 10-digit numbers
# MOBILE_DEFAULT_COUNTRY_CODE=91

# Backend login tokens (issued by POST /api/auth/mobile-verify, checked on protected routes
# via Authorization: Bearer <token>). Use a long random string; never bundle it in the app.
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
# JWT_EXPIRES_IN=7d
# JWT_ISSUER=trustledge-backend

# Admin account for POST /api/auth/admin-login (manages subscription plans).
# Only this login receives role=admin. Use a long password; never bundle it in the app.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_long_admin_password
# Where subscription plans are stored (JSON file, seeded with defaults on first run).
# PLANS_FILE=server/data/plans.json

# Razorpay (backend only). Key id is also returned to the app for Checkout; the
# secret and the webhook secret never leave the backend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret entered when creating the webhook in the Razorpay dashboard
# (URL: https://<your-backend>/api/webhooks/razorpay, events: subscription.*).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Razorpay LIVE plan ids, created manually in the Razorpay dashboard. One per internal
# plan id: RAZORPAY_<PLAN_ID>_PLAN_ID. The backend never creates Razorpay plans.
RAZORPAY_MONTHLY_PLAN_ID=plan_xxxxxxxxxxxxxx
RAZORPAY_QUARTERLY_PLAN_ID=plan_yyyyyyyyyyyyyy
# Optional: billing cycles per subscription (default ~10 years per interval).
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=
# Where subscriptions + processed webhook ids are stored.
# SUBSCRIPTIONS_FILE=server/data/subscriptions.json
